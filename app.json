{
  "expo": {
    "name": "se-project",
    "slug": "se-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "seproject",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3824c66-0ba7-425f-81f7-fbd0081b8749"
      }
    },
    "owner": "boerrigters-team"
  }
}
